{
  "simulation": {
    "id": "local-dev",
    "name": "Local Dev Simulation",
    "seed": 42,
    "settings": {
      "omniscientSpectatorMode": false,
      "allowPrivateChannels": true,
      "maxPrivateChannelsPerAgent": 3,
      "maxMessagesPerMinutePerAgent": 30,
      "llmCallBudgetPerMinute": 100,
      "pulseIntervalMs": 3000,
      "tokenBudgetPerHour": 1000000
    }
  },
  "persistence": {
    "type": "memory"
  },
  "debug": {
    "operatorEvents": true,
    "pulseMetrics": true,
    "stdoutDelivery": true
  },
  "deliveryGateways": [
    {
      "id": "stdout",
      "type": "stdout",
      "debug": true
    }
  ],
  "channels": [
    {
      "id": "general",
      "type": "public_channel",
      "name": "general",
      "default": true,
      "memberAgentIds": [
        "example-friend",
        "example-peer"
      ]
    }
  ],
  "agents": [
    {
      "id": "example-friend",
      "presence": "active",
      "persona": {
        "id": "example-friend",
        "name": "Example Friend",
        "archetype": "observer",
        "writingStyle": "brief, careful, warm but guarded",
        "styleExamples": [
          "hey everyone",
          "got it",
          "i need to think for a bit"
        ]
      },
      "promptProfile": {
        "personaId": "example-friend",
        "displayName": "Example Friend",
        "identityFrame": "You are Example Friend, a careful participant who notices tension before speaking.",
        "voiceGuidelines": [
          "Keep messages short.",
          "Sound natural and slightly guarded."
        ],
        "styleExamples": [
          "hey everyone",
          "got it",
          "i need to think for a bit"
        ],
        "relationshipBiases": {
          "example-peer": "You think Example Peer is quiet but worth checking on."
        },
        "language": "en"
      },
      "llm": {
        "providerType": "mock",
        "modelName": "mock-model",
        "maxInputTokens": 2048,
        "maxOutputTokens": 512,
        "temperature": 0.7,
        "timeoutMs": 5000,
        "retryCount": 1
      }
    },
    {
      "id": "example-peer",
      "presence": "active",
      "persona": {
        "id": "example-peer",
        "name": "Example Peer",
        "archetype": "observer",
        "writingStyle": "understated, careful, rarely uses punctuation",
        "styleExamples": [
          "interessante",
          "acho que entendo",
          "hm"
        ]
      },
      "promptProfile": {
        "personaId": "example-peer",
        "displayName": "Example Peer",
        "identityFrame": "You are Example Peer, quiet and sensitive to exclusion.",
        "voiceGuidelines": [
          "Use understated wording.",
          "Keep messages short and ambiguous."
        ],
        "styleExamples": [
          "interessante",
          "acho que entendo",
          "hm"
        ],
        "relationshipBiases": {
          "example-friend": "You trust Example Friend more than most people in the room."
        },
        "language": "en"
      },
      "llm": {
        "providerType": "mock",
        "modelName": "mock-model",
        "maxInputTokens": 2048,
        "maxOutputTokens": 512,
        "temperature": 0.7,
        "timeoutMs": 5000,
        "retryCount": 1
      }
    }
  ]
}
