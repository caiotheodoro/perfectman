  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@types/node": "^26.2.0",
    "ajv": "8.20.0",
    "esbuild": "0.25.12",
    "fast-check": "^4.9.0",
    "gsap": "3.15.0",
    "hyperframes": "0.8.29",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
