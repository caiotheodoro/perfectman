{
  "name": "perfectman",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "freellm:dev": "docker compose -f docker/freellmapi/freellmapi.compose.yml up --build",
    "qwen:dev": "docker compose -f docker/qwen3/qwen3.compose.yml up",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
